PORT=3001
# Development auth: accept Authorization: Bearer <firebase-uid>
# Replace with Firebase Admin verification before production.
AUTH_MODE=dev

# Seeded admin account for apps/admin-web (change before any shared environment)
ADMIN_EMAIL=admin@listen.plus
ADMIN_PASSWORD=ListenAdmin1!
ADMIN_NAME=Listen+ Admin

# Local Postgres (URL-encode special chars in the password, e.g. ! → %21, @ → %40)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/listen

# Optional later:
# FIREBASE_PROJECT_ID=listenplus-d9188
