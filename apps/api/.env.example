PORT=3001

# Auth: firebase (required on Cloud Run) | hybrid | dev
# Cloud Run forces firebase unless ALLOW_INSECURE_AUTH=true
AUTH_MODE=firebase

FIREBASE_PROJECT_ID=listenplus-d9188
# Prefer a service account for Admin SDK (required for Firestore + verifyIdToken):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=

DATA_BACKEND=firestore
MEDIA_BACKEND=firebase
FIRESTORE_PREFIX=listen
# Use a real GCS bucket the project owns (default Firebase *.firebasestorage.app
# may not exist until Storage is enabled in the Firebase console).
FIREBASE_STORAGE_BUCKET=listenplus-d9188-media

# Seeded admin for apps/admin-web — use a strong unique password in shared environments
ADMIN_EMAIL=admin@listen.plus
ADMIN_PASSWORD=
ADMIN_NAME=Listen+ Admin
# ADMIN_ALLOW_PROTOTYPE_TOKEN=false

# Local Postgres (only when DATA_BACKEND=postgres)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/listen

# Payments
PAYMENTS_MODE=simulate
# Required on Cloud Run to keep prototype checkout working without a real PSP:
# ALLOW_SIMULATED_PAYMENTS=true
PAYMENT_WEBHOOK_SECRET=
ALLOW_CLIENT_GRANTS=false

# Media signing (required on Cloud Run)
MEDIA_SIGNING_SECRET=
MEDIA_REQUIRE_SIGNED=true

# Advertising (AdMob → creator ledger). Gross per verified reward in minor units.
AD_GROSS_MINOR=50
# SSV callback path: GET/POST /v1/ads/ssv — configure in AdMob console on each unit.
